# Backend API env — copy to backend/.env (never commit).
# The API also loads root ../.env; use this file for API-only overrides.
# Full variable list + frontend vars: see ../.env.example
DATABASE_URL=postgresql://user:password@localhost:5432/abdelrhmanabdelkhalek

# --- Database connection options (see docs/DATA_LAYER.md) ---
# Explicit session pooler (overrides auto-rewrite from direct Supabase URL)
# DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# Force direct connection — use when pooler returns "Tenant or user not found" / ENOTFOUND
# DATABASE_USE_DIRECT=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_REGION=eu-north-1
# SUPABASE_PROJECT_REF=your_project_ref
JWT_SECRET=change_me_min_32_chars_random_string_here
JWT_REFRESH_SECRET=change_me_another_32_chars_random_string
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,https://abdelrhmanabdelkhalek-react.vercel.app,https://abdelrhmanabdelkhalek.com,https://www.abdelrhmanabdelkhalek.com,https://squash.abdelrhmanabdelkhalek.com

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=abdelrhmanabdelkhalek-assets
# Optional: R2 public dev URL while custom CDN DNS is pending
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Set USE_CDN=true only after cdn.abdelrhmanabdelkhalek.com resolves (Cloudflare R2 custom domain)
USE_CDN=false
CDN_BASE_URL=https://cdn.abdelrhmanabdelkhalek.com
# Optional media base when USE_CDN=false (defaults to Supabase storage URLs in API responses)
# MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Set R2_PUBLIC_URL when uploading to R2 with USE_CDN=false so API returns pub-*.r2.dev URLs
