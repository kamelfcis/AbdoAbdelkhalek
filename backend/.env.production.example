# Backend production environment (Railway / Render / VPS — documentation only)
# Copy to host secret store. Never commit filled values.
# API loads root ../.env then backend/.env — prefer host env injection.

NODE_ENV=production
API_PORT=4000

# Postgres (production instance — not Supabase pooler unless verified)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_POOLER_URL=   # optional session pooler
# DATABASE_USE_DIRECT=true

# Auth — REQUIRED in production (env.ts throws if missing when NODE_ENV=production)
JWT_SECRET=generate_32_plus_random_chars
JWT_REFRESH_SECRET=generate_different_32_plus_random_chars

# CORS — comma-separated or single origin; must include all frontend origins
CORS_ORIGIN=https://abdelrhmanabdelkhalek.com,https://www.abdelrhmanabdelkhalek.com,https://squash.abdelrhmanabdelkhalek.com

# CDN / R2
USE_CDN=true
CDN_BASE_URL=https://cdn.abdelrhmanabdelkhalek.com
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=abdelrhmanabdelkhalek-assets
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Supabase REST fallback (optional until Postgres-only stable)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_REGION=eu-north-1

# Optional monitoring (not wired in code yet — see docs/MONITORING_REPORT.md)
# SENTRY_DSN=
# LOG_LEVEL=info
