{
  "name": "abdelrhmanabdelkhalek-react",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "migration-toolkit",
    "backend"
  ],
  "dependencies": {
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@splidejs/react-splide": "^0.7.12",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.5",
    "react-scripts": "5.0.1",
    "sweetalert2": "^11.26.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.181.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:squash": "node scripts/start-with-domain.js squash",
    "start:fitness": "node scripts/start-with-domain.js fitness",
    "build": "react-scripts build",
    "vercel-build": "npm run prisma:generate --workspace=backend && npm run build --workspace=backend && npm run build",
    "postinstall": "npm run prisma:generate --workspace=backend",
    "clean": "rimraf build",
    "clean-build": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:gate": "playwright test --project=chromium",
    "test:e2e:squash": "playwright test --project=squash-landing",
    "test:e2e:ui": "playwright test --ui",
    "eject": "react-scripts eject",
    "analyze": "node scripts/analyze-bundle.js",
    "analyze-sourcemap": "set GENERATE_SOURCEMAP=true && npm run build && npx source-map-explorer build/static/js/*.js",
    "analyze-html": "set GENERATE_SOURCEMAP=true && npm run build && npx source-map-explorer build/static/js/*.js --html bundle-report.html",
    "backup-all": "npm run backup-all --workspace=migration-toolkit",
    "export-db": "npm run export-db --workspace=migration-toolkit",
    "export-storage": "npm run export-storage --workspace=migration-toolkit",
    "export-auth": "npm run export-auth --workspace=migration-toolkit",
    "upload-r2": "npm run upload-r2 --workspace=migration-toolkit",
    "upload-r2-stream": "npm run upload-r2-stream --workspace=migration-toolkit",
    "replace-urls": "npm run replace-urls --workspace=migration-toolkit",
    "generate-prisma": "npm run generate-prisma --workspace=migration-toolkit",
    "restore-postgres": "npm run restore-postgres --workspace=migration-toolkit",
    "verify-migration": "npm run verify-migration --workspace=migration-toolkit",
    "discover-r2-public": "npm run discover-r2-public --workspace=migration-toolkit",
    "set-r2-public": "npm run set-r2-public --workspace=migration-toolkit",
    "backend:dev": "node scripts/dev-fullstack.js",
    "backend:api": "npm run dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:test": "npm run test --workspace=backend"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.33",
    "caniuse-lite": "^1.0.30001793",
    "jsdom": "^27.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "webpack-bundle-analyzer": "^5.1.0"
  }
}
