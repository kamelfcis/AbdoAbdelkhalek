# Vercel production environment (Fitness project — abdelrhmanabdelkhalek.com)
# Copy names/values into Vercel Dashboard → Project → Settings → Environment Variables
# Do NOT commit real secrets. Use Production scope for all vars below.

# API (required)
REACT_APP_API_URL=/api

# Domain routing (required — fitness root site)
REACT_APP_DOMAIN=fitness

# Media / CDN — enable after cutover testing (see docs/cloudflare-cdn.md)
REACT_APP_USE_CDN=true
REACT_APP_CDN_URL=https://cdn.abdelrhmanabdelkhalek.com
# Fallback while USE_CDN=false:
# REACT_APP_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# REACT_APP_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Legacy Supabase URL (used only when CDN off + path rewrite)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Upload: proxy for images ≤4 MB; videos/large files auto-upload via presigned PUT to R2.
# Requires R2 bucket CORS for your production origins (see docs/cloudflare-cdn.md).
REACT_APP_UPLOAD_VIA_API=true

# Data layer (default: Node API)
# REACT_APP_USE_API=true

# CRA build on Vercel
DISABLE_ESLINT_PLUGIN=true
CI=false
