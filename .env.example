# Copy to .env and fill in real values. Never commit .env.
# Backend-only overrides: see backend/.env.example (API loads root .env + backend/.env).

# Supabase (source — for migration export only)
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# PostgreSQL direct connection (Settings → Database → Connection string → Direct)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Database connection options (see docs/DATA_LAYER.md) ---
# Session pooler (recommended when direct host is blocked): port 5432, user postgres.PROJECT_REF
# DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
# Transaction pooler (serverless): port 6543, append ?pgbouncer=true — not ideal for Prisma migrations
# DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Bypass auto pooler rewrite and use DATABASE_URL host directly (fix for "Tenant or user not found")
# DATABASE_USE_DIRECT=true
SUPABASE_DB_REGION=eu-north-1

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=abdelrhmanabdelkhalek-assets
# Optional: R2 public dev URL (R2 bucket → Settings → Public access → r2.dev) while custom CDN DNS is pending
# CLOUDFLARE_API_TOKEN=   # optional, for npm run discover-r2-public
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Media / CDN — keep USE_CDN=false until cdn.* resolves in Cloudflare (see docs/cloudflare-cdn.md)
USE_CDN=false
CDN_BASE_URL=https://cdn.abdelrhmanabdelkhalek.com
# Optional override when USE_CDN=false (defaults to Supabase storage URLs)
# MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Backend API (after migration)
JWT_SECRET=change_me_min_32_chars_random_string_here
JWT_REFRESH_SECRET=change_me_another_32_chars_random_string
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# CRA frontend
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Match backend USE_CDN — false uses Supabase storage URLs until CDN DNS is live
REACT_APP_USE_CDN=false
REACT_APP_CDN_URL=https://cdn.abdelrhmanabdelkhalek.com
# REACT_APP_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# REACT_APP_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Upload: proxy for small files (≤4 MB) on localhost when true/unset locally.
# Files >4 MB always use presigned PUT to R2 (required on Vercel — serverless body limit ~4.5 MB).
# Set false to presign all uploads in production (requires R2 bucket CORS — see docs/cloudflare-cdn.md).
# REACT_APP_UPLOAD_VIA_API=true

# Migration toolkit tuning
EXPORT_PAGE_SIZE=1000
EXPORT_MAX_CONCURRENCY=4
STORAGE_DOWNLOAD_CONCURRENCY=8
R2_UPLOAD_CONCURRENCY=10
